# Sandbox credentials only. Never use VITE_ for any of these values.
PORT=8080
STOREFRONT_URL=http://localhost:8081
PUBLIC_BASE_URL=http://localhost:8080
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_API_KEY=REPLACE_WITH_SANDBOX_MERCHANT_API_KEY
SAFEPAY_SECRET_KEY=REPLACE_WITH_SANDBOX_MERCHANT_SECRET_KEY
SAFEPAY_WEBHOOK_SECRET=REPLACE_WITH_SANDBOX_ENDPOINT_HMAC_SECRET
MONGODB_URI=mongodb+srv://REPLACE_USERNAME:REPLACE_PASSWORD@REPLACE_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=tab_cafe_payment_poc
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POC_API_TOKEN=REPLACE_WITH_RANDOM_LOCAL_API_TOKEN
# Optional dedicated, disposable replica-set DB URI for integration tests only.
# TEST_MONGODB_URI=
